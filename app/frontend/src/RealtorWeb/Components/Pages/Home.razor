@page "/"

<PageTitle>Realtor foundation</PageTitle>

<div class="page-container">
    <header class="page-header">
        <p class="eyebrow">Realtor</p>
        <h1 class="page-title">Base da solução</h1>
        <p class="page-subtitle">Estrutura inicial compartilhada para o backend, frontend e testes.</p>
    </header>

    <section class="card">
        <div class="card-header">
            <h2>Infraestrutura inicial</h2>
        </div>
        <div class="card-body">
            <ul class="feature-list">
                <li>Backend em ASP.NET Core Minimal APIs</li>
                <li>Frontend em Blazor Web App com Razor Components</li>
                <li>Projetos de testes separados</li>
                <li>SDK alinhado ao arquivo global.json do repositório</li>
            </ul>
        </div>
    </section>
</div>
